# ─── AI Models ──────────────────────────────────────────────────────────────────
# Local Ollama instance (required for story selection and script generation)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini — used as fallback if Ollama is unavailable
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Stock Footage ───────────────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here

# ─── Pipeline Tuning (optional — defaults shown) ─────────────────────────────────
VIDEOS_PER_RUN=10
SCRIPT_RETRY_ATTEMPTS=2
MIN_SCRIPT_SCORE=7
NETWORK_RETRIES=2
RSS_STORIES_PER_SOURCE=12

# ─── YouTube ─────────────────────────────────────────────────────────────────────
# Place your OAuth2 credentials file as credentials.json in the project root.
# The bot will guide you through authentication on first run.
# Do NOT commit token.json or credentials.json to version control.
